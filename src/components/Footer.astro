---
import SocialLinks from './SocialLinks.astro';
---
<footer class="site-footer">
  <div class="footer-theme-switch" role="group" aria-label="Estilo visual">
    <button type="button" data-visual-theme="teal" aria-pressed="false">Teal</button>
    <span aria-hidden="true">·</span>
    <button type="button" data-visual-theme="comic" aria-pressed="true">Cómic</button>
  </div>
  <div class="container footer-row">
    <div class="footer-copyright">© <span data-year></span> Vicente Perpiñá Giner</div>
    <div class="footer-links">
      <div class="footer-nav-links">
        <a href="/obra/">Obra</a>
        <a href="/docencia/">Docencia</a>
        <a href="/trayectoria/">Trayectoria</a>
        <a href="/prensa/">Prensa</a>
        <a href="/contacto/">Contacto</a>
        <a href="https://blog.vicenteperpina.com" target="_blank" rel="noopener">Blog</a>
      </div>
      <SocialLinks placement="footer" />
    </div>
  </div>
</footer>
