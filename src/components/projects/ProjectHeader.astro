---
import ProjectTags from './ProjectTags.astro';
import type { Project } from '../../lib/projects';
import { projectDateLabel, projectTypeLabel } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<header class="project-detail-hero">
  <div class="container project-detail-hero__inner">
    <a class="project-back" href="/obra/">← Volver a Obra</a>
    <div class="project-detail-kicker">
      {projectDateLabel(project) && <span>{projectDateLabel(project)}</span>}
      <span>{projectTypeLabel(project.type)}</span>
    </div>
    <h1>{project.title}</h1>
    {project.subtitle && <p class="project-detail-subtitle">{project.subtitle}</p>}
    {project.summary && <p class="project-detail-summary">{project.summary}</p>}
    <ProjectTags categories={project.categories} />
  </div>
</header>
