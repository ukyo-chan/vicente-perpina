---
import ProjectTags from './ProjectTags.astro';
import { projectTypeLabel } from '../../lib/projects';

interface Props {
  project: any;
}

const { project } = Astro.props;
const { data } = project;
---
<header class="project-detail-hero">
  <div class="container project-detail-hero__inner">
    <a class="project-back" href="/obra/">← Volver a Obra</a>
    <div class="project-detail-kicker">
      <span>{data.fechaTexto ?? data.anio}</span>
      <span>{projectTypeLabel(data.tipoPrincipal)}</span>
    </div>
    <h1>{data.titulo}</h1>
    {data.subtitulo && <p class="project-detail-subtitle">{data.subtitulo}</p>}
    <p class="project-detail-summary">{data.resumen}</p>
    <ProjectTags categories={data.categorias} />
  </div>
</header>
