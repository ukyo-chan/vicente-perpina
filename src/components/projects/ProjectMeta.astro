---
import type { Project } from '../../lib/projects';
import { projectPeriodLabel } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const year = project.year ? String(project.year) : undefined;
const period = projectPeriodLabel(project);
const date = !period && project.dateText && project.dateText !== year
  ? project.dateText
  : !period && project.dates && project.dates !== year
    ? project.dates
    : undefined;
const location = [project.address, project.place].filter(Boolean).join(' · ');
const rows = [
  ['Año', year],
  ['Fecha', date],
  ['Periodo', period],
  ['Hora', project.time],
  ['Rol', project.role],
  ['Espacio / entidad', project.entity],
  ['Lugar', location],
  ['Colaboración', project.collaborators.length ? project.collaborators.join(' · ') : undefined]
].filter(([, value]) => Boolean(value));
---
{rows.length > 0 && (
  <aside class="project-facts" aria-label="Datos del proyecto">
    <p class="eyebrow">Ficha</p>
    <dl>
      {rows.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </aside>
)}
