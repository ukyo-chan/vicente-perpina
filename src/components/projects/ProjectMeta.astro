---
import type { Project } from '../../lib/projects';
import { projectDateLabel } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const rows = [
  ['Año', projectDateLabel(project)],
  ['Rol', project.role],
  ['Entidad / proyecto', project.entity],
  ['Lugar', project.place],
  ['Fechas', project.dates],
  ['Colaboración', project.collaborators.length ? project.collaborators.join(' · ') : undefined]
].filter(([, value]) => Boolean(value));
---
{rows.length > 0 && (
  <aside class="project-facts" aria-label="Datos del proyecto">
    <p class="eyebrow">Ficha</p>
    <dl>
      {rows.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </aside>
)}
