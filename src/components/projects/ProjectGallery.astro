---
import ImageGallery from '../gallery/ImageGallery.astro';

interface Props {
  images: Array<{ src: string; alt: string; pie?: string }>;
}

const { images = [] } = Astro.props;
---
<ImageGallery
  images={images}
  heading="Galería"
  headingId="galeria-proyecto"
  lightboxLabel="Visor de imágenes"
/>
