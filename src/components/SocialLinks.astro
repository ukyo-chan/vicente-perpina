---
interface Props {
  placement: 'header' | 'header-mobile' | 'footer';
}

const { placement } = Astro.props;
---
<div class:list={['social-icon-links', `social-icon-links--${placement}`]} role="group" aria-label="Redes sociales">
  <a
    class="social-icon-link"
    href="https://www.instagram.com/vicenteperpinya/"
    target="_blank"
    rel="noopener"
    aria-label="Instagram de Vicente Perpiñá (se abre en una pestaña nueva)"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4.25"></circle>
      <circle class="social-icon-dot" cx="17.4" cy="6.7" r="1"></circle>
    </svg>
  </a>
  <a
    class="social-icon-link"
    href="https://es.linkedin.com/in/vicenteperpinya"
    target="_blank"
    rel="noopener"
    aria-label="LinkedIn de Vicente Perpiñá (se abre en una pestaña nueva)"
  >
    <svg class="social-icon-linkedin" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5.3 3.4a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8ZM3.7 8.6h3.2V20H3.7V8.6Zm5.2 0H12v1.6h.1c.4-.8 1.5-1.8 3.3-1.8 3.5 0 4.1 2.3 4.1 5.2V20h-3.2v-5.7c0-1.4 0-3.2-2-3.2s-2.2 1.5-2.2 3.1V20H8.9V8.6Z"></path>
    </svg>
  </a>
</div>
