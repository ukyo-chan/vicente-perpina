---
import { PRESS_TYPE_LABELS, type PressItem } from '../../lib/press';
import { projectPrimaryHref, type Project } from '../../lib/projects';

interface Props {
  item: PressItem;
  relatedProject?: Project;
  featured?: boolean;
}

const { item, relatedProject, featured = false } = Astro.props;
const relatedHref = relatedProject ? projectPrimaryHref(relatedProject) : undefined;
const actionLabel = item.types.includes('radio') ? 'Escuchar en' : 'Abrir en';
---

{featured ? (
  <article class="press-card press-card--featured">
    <div class="press-card-meta">
      <span>{item.date ?? 'Fecha no indicada'}</span>
      <span>{item.medium}</span>
    </div>
    <div class="press-type-list" aria-label="Tipo de pieza">
      {item.types.map(type => <span class="press-type">{PRESS_TYPE_LABELS[type]}</span>)}
    </div>
    <h3>{item.title}</h3>
    {item.program && <p class="press-program">{item.program}</p>}
    <p class="press-description">{item.description}</p>
    <div class="press-card-footer">
      {relatedProject && relatedHref && (
        <a class="press-related" href={relatedHref}>Proyecto relacionado: {relatedProject.title} →</a>
      )}
      <div class="press-actions">
        {item.duration && <span class="press-duration">Duración: {item.duration}</span>}
        {item.url ? (
          <a class="text-link" href={item.url} target="_blank" rel="noopener">{actionLabel} {item.medium} ↗</a>
        ) : (
          <span class="press-link-pending">Referencia sin enlace estable</span>
        )}
      </div>
    </div>
  </article>
) : (
  <article class="press-card press-card--compact">
    <div class="press-card-compact-meta">
      <span class="press-card-date">{item.date ?? 'Fecha no indicada'}</span>
      <span class="press-card-medium">{item.medium}</span>
    </div>
    <div class="press-card-compact-body">
      <div class="press-type-list" aria-label="Tipo de pieza">
        {item.types.map(type => <span class="press-type">{PRESS_TYPE_LABELS[type]}</span>)}
      </div>
      <h3>{item.title}</h3>
      {item.program && <p class="press-program">{item.program}</p>}
      <p class="press-description">{item.description}</p>
      <div class="press-card-footer">
        {relatedProject && relatedHref && (
          <a class="press-related" href={relatedHref}>Proyecto relacionado: {relatedProject.title} →</a>
        )}
        <div class="press-actions">
          {item.duration && <span class="press-duration">Duración: {item.duration}</span>}
          {item.url ? (
            <a class="text-link" href={item.url} target="_blank" rel="noopener">{actionLabel} {item.medium} ↗</a>
          ) : (
            <span class="press-link-pending">Referencia sin enlace estable</span>
          )}
        </div>
      </div>
    </div>
  </article>
)}
