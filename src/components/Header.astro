---
import SocialLinks from './SocialLinks.astro';

const pathname = Astro.url.pathname;

const isCurrent = (route) => {
  if (route === '/') return pathname === '/';
  return pathname === route || pathname.startsWith(`${route}`);
};

const navigation = [
  { href: '/', label: 'Inicio', current: isCurrent('/') },
  { href: '/obra/', label: 'Obra', current: isCurrent('/obra/') || pathname.startsWith('/proyectos/') },
  { href: '/docencia/', label: 'Docencia', current: isCurrent('/docencia/') },
  { href: '/trayectoria/', label: 'Trayectoria', current: isCurrent('/trayectoria/') },
  { href: '/prensa/', label: 'Prensa', current: isCurrent('/prensa/') },
  { href: '/contacto/', label: 'Contacto', current: isCurrent('/contacto/') }
];
---
<header class="site-header">
  <div class="container navbar">
    <a class="brand" href="/" aria-label="Vicente Perpiñá Giner — Inicio">
      <span class="brand-full">VICENTE PERPIÑÁ GINER</span>
      <span class="brand-short" aria-hidden="true">VICENTE PERPIÑÁ</span>
    </a>
    <div class="mobile-header-actions">
      <SocialLinks placement="header-mobile" />
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
    </div>
    <nav class="nav-links" aria-label="Navegación principal">
      {navigation.map(({ href, label, current }) => (
        <a href={href} aria-current={current ? 'page' : undefined}>
          <span>{label}</span>
          {current && (
            <svg
              class="nav-active-ring"
              viewBox="0 0 100 44"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                pathLength="1"
                d="M 7 22 C 7 9, 23 3, 49 3 C 76 2, 94 8, 95 21 C 96 34, 79 41, 51 41 C 24 42, 6 35, 7 22 Z"
              ></path>
            </svg>
          )}
        </a>
      ))}
      <a href="https://blog.vicenteperpina.com" target="_blank" rel="noopener">Blog</a>
      <SocialLinks placement="header" />
    </nav>
  </div>
</header>
