---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioProjectCard from '../../components/projects/PortfolioProjectCard.astro';
import { PROJECT_SECTIONS, getObraArchiveProjects, getObraProjects, loadProjects } from '../../lib/projects';

const projects = await loadProjects();
---
<BaseLayout
  title="Obra y proyectos · Vicente Perpiñá Giner"
  description="Reúno mi obra y mis proyectos de ilustración, exposiciones, cómic, edición, animación y audiovisual."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Trabajo artístico</p>
        <h1>Obra y proyectos</h1>
        <p>
          Aquí reúno un catálogo amplio y en crecimiento de proyectos que recorre ilustración y dibujo, exposiciones, cómic y edición,
          encargos editoriales, animación y creación audiovisual.
        </p>
      </div>
    </section>

    <div class="section-nav-wrap">
      <nav class="container section-nav" aria-label="Secciones de obra">
        {PROJECT_SECTIONS.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
      </nav>
    </div>

    {PROJECT_SECTIONS.map(section => {
      const sectionProjects = getObraProjects(projects, section.id);
      const archiveProjects = getObraArchiveProjects(projects, section.id);
      const soft = section.id === 'comic-edicion' || section.id === 'animacion-audiovisual';

      return (
        <section
          class:list={['section', soft && 'soft']}
          id={section.id}
        >
          <div class="container">
            <div class="section-heading reveal">
              <div>
                <p class="eyebrow">{section.number}</p>
                <h2>{section.title}</h2>
              </div>
              <p>{section.description}</p>
            </div>

            {section.layout === 'grid' && (
              <div class="project-grid">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="grid" />)}
              </div>
            )}

            {section.layout === 'editorial' && (
              <div class="editorial-grid">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="editorial" />)}
              </div>
            )}

            {section.layout === 'media' && (
              <div class="media-timeline">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="media" />)}
              </div>
            )}

            {archiveProjects.length > 0 && (
              <div class="archive-panel reveal">
                <p class="eyebrow">Autoedición y colaboraciones</p>
                <h3>Otros proyectos gráficos</h3>
                <div class="archive-tags">
                  {archiveProjects.map(project => (
                    <span>{project.title}</span>
                  ))}
                </div>
              </div>
            )}

            {section.id === 'animacion-audiovisual' && (
              <div class="portfolio-note reveal">
                <strong>Archivo vivo.</strong> Seguiré ampliando este archivo con nuevos proyectos, obra visual, fotografías de exposiciones,
                publicaciones y otros materiales.
              </div>
            )}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>

<script>
  const gridPositionClasses = ['is-grid-top', 'is-grid-right', 'is-grid-bottom', 'is-grid-left', 'is-grid-row-filler'];
  const projectGrids = Array.from(document.querySelectorAll('.project-grid'));
  const pendingGrids = new WeakSet();
  const gridResizeObservers = [];
  const gridVisibilityObservers = [];

  function getGridCards(grid) {
    return Array.from(grid.children).filter((child) =>
      child instanceof HTMLElement && child.classList.contains('project-card')
    );
  }

  function isVisibleCard(card) {
    if (card.hidden) return false;

    const style = window.getComputedStyle(card);
    return style.display !== 'none'
      && style.visibility !== 'hidden'
      && card.getClientRects().length > 0;
  }

  function getColumnCount(grid) {
    const style = window.getComputedStyle(grid);
    const declaredColumnCount = Number.parseInt(style.getPropertyValue('--project-grid-column-count'), 10);

    if (Number.isInteger(declaredColumnCount) && declaredColumnCount > 0) {
      return declaredColumnCount;
    }

    const columns = style.gridTemplateColumns
      .trim()
      .split(/\s+/)
      .filter(Boolean);

    return Math.max(1, columns.length);
  }

  function setPositionClass(card, className, active) {
    if (card.classList.contains(className) !== active) {
      card.classList.toggle(className, active);
    }
  }

  function updateProjectGridEdges(grid) {
    const cards = getGridCards(grid);
    const visibleCards = cards.filter(isVisibleCard);
    const visiblePositions = new Map(visibleCards.map((card, index) => [card, index]));
    const columnCount = getColumnCount(grid);
    const rowCount = visibleCards.length > 0 ? Math.ceil(visibleCards.length / columnCount) : 0;

    cards.forEach((card) => {
      const index = visiblePositions.get(card);

      if (index === undefined) {
        gridPositionClasses.forEach((className) => setPositionClass(card, className, false));
        if (card.style.getPropertyValue('--grid-column-span')) {
          card.style.removeProperty('--grid-column-span');
        }
        return;
      }

      const row = Math.floor(index / columnCount);
      const column = index % columnCount;
      const rowStart = row * columnCount;
      const itemsInRow = Math.min(columnCount, visibleCards.length - rowStart);
      const isLastVisibleCard = index === visibleCards.length - 1;
      const fillsIncompleteRow = columnCount > 1
        && row === rowCount - 1
        && itemsInRow < columnCount
        && isLastVisibleCard;
      const columnSpan = fillsIncompleteRow ? columnCount - column : 1;

      setPositionClass(card, 'is-grid-top', row === 0);
      setPositionClass(card, 'is-grid-right', column === itemsInRow - 1);
      setPositionClass(card, 'is-grid-bottom', row === rowCount - 1);
      setPositionClass(card, 'is-grid-left', column === 0);
      setPositionClass(card, 'is-grid-row-filler', fillsIncompleteRow);

      const currentSpan = card.style.getPropertyValue('--grid-column-span');
      if (fillsIncompleteRow && currentSpan !== String(columnSpan)) {
        card.style.setProperty('--grid-column-span', String(columnSpan));
      } else if (!fillsIncompleteRow && currentSpan) {
        card.style.removeProperty('--grid-column-span');
      }
    });
  }

  function scheduleGridUpdate(grid) {
    if (pendingGrids.has(grid)) return;

    pendingGrids.add(grid);
    window.requestAnimationFrame(() => {
      pendingGrids.delete(grid);
      updateProjectGridEdges(grid);
    });
  }

  projectGrids.forEach((grid) => {
    scheduleGridUpdate(grid);

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => scheduleGridUpdate(grid));
      resizeObserver.observe(grid);
      gridResizeObservers.push(resizeObserver);
    } else {
      window.addEventListener('resize', () => scheduleGridUpdate(grid));
    }

    if ('MutationObserver' in window) {
      const visibilityObserver = new MutationObserver(() => scheduleGridUpdate(grid));
      visibilityObserver.observe(grid, {
        attributes: true,
        attributeFilter: ['class', 'hidden', 'style'],
        childList: true,
        subtree: true
      });
      gridVisibilityObservers.push(visibilityObserver);
    }
  });
</script>
