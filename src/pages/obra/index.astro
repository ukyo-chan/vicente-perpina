---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioProjectCard from '../../components/projects/PortfolioProjectCard.astro';
import { PROJECT_SECTIONS, getObraArchiveProjects, getObraProjects, loadProjects } from '../../lib/projects';

const projects = await loadProjects();
---
<BaseLayout
  title="Obra y proyectos · Vicente Perpiñá Giner"
  description="Reúno mi obra y mis proyectos de ilustración, exposiciones, cómic, edición, animación y audiovisual."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Trabajo artístico</p>
        <h1>Obra y proyectos</h1>
        <p>
          Aquí reúno un catálogo amplio y en crecimiento de proyectos que recorre ilustración y dibujo, exposiciones, cómic y edición,
          encargos editoriales, animación y creación audiovisual.
        </p>
      </div>
    </section>

    <div class="section-nav-wrap">
      <nav class="container section-nav" aria-label="Secciones de obra">
        {PROJECT_SECTIONS.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
      </nav>
    </div>

    {PROJECT_SECTIONS.map(section => {
      const sectionProjects = getObraProjects(projects, section.id);
      const archiveProjects = getObraArchiveProjects(projects, section.id);
      const soft = section.id === 'comic-edicion' || section.id === 'animacion-audiovisual';

      return (
        <section
          class:list={['section', soft && 'soft']}
          id={section.id}
        >
          <div class="container">
            <div class="section-heading reveal">
              <div>
                <p class="eyebrow">{section.number}</p>
                <h2>{section.title}</h2>
              </div>
              <p>{section.description}</p>
            </div>

            {section.layout === 'grid' && (
              <div class="project-grid">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="grid" />)}
              </div>
            )}

            {section.layout === 'editorial' && (
              <div class="editorial-grid">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="editorial" />)}
              </div>
            )}

            {section.layout === 'media' && (
              <div class="media-timeline">
                {sectionProjects.map(project => <PortfolioProjectCard project={project} layout="media" />)}
              </div>
            )}

            {archiveProjects.length > 0 && (
              <div class="archive-panel reveal">
                <p class="eyebrow">Autoedición y colaboraciones</p>
                <h3>Otros proyectos gráficos</h3>
                <div class="archive-tags">
                  {archiveProjects.map(project => (
                    <span>{project.title}</span>
                  ))}
                </div>
              </div>
            )}

            {section.id === 'animacion-audiovisual' && (
              <div class="portfolio-note reveal">
                <strong>Archivo vivo.</strong> Seguiré ampliando este archivo con nuevos proyectos, obra visual, fotografías de exposiciones,
                publicaciones y otros materiales.
              </div>
            )}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>
