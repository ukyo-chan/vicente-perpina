---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/projects/ProjectHeader.astro';
import ProjectMeta from '../../components/projects/ProjectMeta.astro';
import ProjectGallery from '../../components/projects/ProjectGallery.astro';
import ProjectLinks from '../../components/projects/ProjectLinks.astro';
import RelatedProjects from '../../components/projects/RelatedProjects.astro';
import {
  getRelatedProjects,
  loadProjectEntries,
  projectFromEntry,
  type ProjectEntry
} from '../../lib/projects';

export async function getStaticPaths() {
  const entries = await loadProjectEntries();
  return entries
    .filter(entry => entry.data.publicar && entry.data.detalle)
    .map(entry => ({
      params: { slug: entry.id },
      props: { entry }
    }));
}

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const project = projectFromEntry(entry);
const { Content } = await render(entry);
const allEntries = await loadProjectEntries();
const allProjects = allEntries.map(projectFromEntry).filter(candidate => candidate.published);
const relatedProjects = getRelatedProjects(project, allProjects, 2);

const title = project.seo?.title ?? `${project.title} · Vicente Perpiñá Giner`;
const description = project.seo?.description ?? project.summary;
const socialImage = project.image?.src ?? '/assets/img/vicente.png';
const gallery = project.image
  ? [project.image, ...project.gallery.filter(image => image.src !== project.image?.src)]
  : project.gallery;
---
<BaseLayout title={title} description={description} image={socialImage} ogType="article">
  <main>
    <ProjectHeader project={project} />

    <section class="section project-detail-section">
      <div class="container project-detail-layout">
        <article class="project-content">
          <Content />
        </article>
        <ProjectMeta project={project} />
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="section soft project-detail-extra">
        <div class="container">
          <ProjectGallery images={gallery} />
        </div>
      </section>
    )}

    <section class="section project-detail-extra">
      <div class="container">
        <ProjectLinks links={project.links} />
        <RelatedProjects projects={relatedProjects} />
        <div class="project-detail-footer">
          <a class="btn secondary" href="/obra/">← Volver a Obra</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
