---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeachingTimelineItem from '../../components/teaching/TeachingTimelineItem.astro';
import { loadTeaching } from '../../lib/teaching';

const experiences = await loadTeaching();
---
<BaseLayout
  title="Docencia · Vicente Perpiñá Giner"
  description="Comparto mi experiencia docente en dibujo, pintura, ilustración, cómic, dibujo técnico y educación artística."
>
  <main>
<section class="page-hero">
    <div class="container">
      <p class="eyebrow">Experiencia educativa</p>
      <h1>Docencia</h1>
      <p>
        Trabajo desde el dibujo, la pintura, la ilustración, el cómic y el dibujo técnico, junto con el acompañamiento académico.
        Acompaño a alumnado de diferentes edades y adapto el trabajo a ritmos y necesidades diversas.
      </p>
      <div class="tag-list">
        <span class="tag">Dibujo</span>
        <span class="tag">Pintura</span>
        <span class="tag">Ilustración</span>
        <span class="tag">Cómic</span>
        <span class="tag">Dibujo técnico</span>
        <span class="tag">ESO y Bachillerato</span>
        <span class="tag">Niños y jóvenes</span>
        <span class="tag">Adultos</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Experiencia</p>
          <h2>Enseñar desde la práctica artística</h2>
        </div>
        <p>Aquí reúno experiencias que resumen mi recorrido docente en contextos muy distintos.</p>
      </div>

      <div class="timeline">
        {experiences.map((experience) => <TeachingTimelineItem experience={experience} />)}
      </div>

      <div class="two-col teaching-panels">
        <section class="panel reveal">
          <p class="eyebrow">Enfoque</p>
          <h2>Cómo entiendo la enseñanza</h2>
          <p>
            Me interesa acompañar a niños, adolescentes y adultos, tanto en contextos presenciales como online, en su desarrollo creativo,
            adaptando las actividades a distintos ritmos y necesidades. Planteo el aprendizaje artístico como un proceso inclusivo y motivador
            de observación, experimentación, práctica y comunicación.
          </p>
        </section>

        <aside class="panel reveal">
          <p class="eyebrow">Recursos</p>
          <h3>Arte aplicado al aula</h3>
          <ul class="compact-list">
            <li>Dibujo artístico y dibujo técnico</li>
            <li>Ilustración y narrativa visual</li>
            <li>Cómic y autoedición</li>
            <li>Animación y audiovisual</li>
            <li>Fotografía y cultura visual</li>
            <li>Planificación de actividades y proyectos</li>
            <li>Proyectos interdisciplinares</li>
          </ul>
        </aside>
      </div>

      <div class="teaching-callout reveal">
        <div>
          <p class="eyebrow">Perfil diferencial</p>
          <h2>Mi experiencia profesional entra en el aula</h2>
        </div>
        <p>
          Mi práctica en ilustración, cómic y edición, junto con el trabajo en animación, audiovisual y proyectos expositivos,
          me permite plantear actividades conectadas con procesos reales de creación, comunicación visual y trabajo por proyectos.
        </p>
        <a class="btn secondary" href="/obra/">Explorar obra y proyectos</a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
