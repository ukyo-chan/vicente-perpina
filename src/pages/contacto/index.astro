---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contacto · Vicente Perpiñá Giner"
  description="Puedes contactarme para proyectos docentes, ilustración, cómic, talleres y colaboraciones artísticas."
>
  <main>
<section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contacto profesional</p>
      <h1>Hablemos</h1>
      <p>
        Si tienes un proyecto docente, un encargo de ilustración, un taller de cómic, un proyecto editorial o una colaboración artística, puedes escribirme.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-item reveal">
          <span>Correo electrónico</span>
          <a href="mailto:vicenteperpinyaginer@gmail.com">vicenteperpinyaginer@gmail.com</a>
        </div>

        <div class="contact-item reveal">
          <span>Ubicación</span>
          <strong>Alfafar · València</strong>
        </div>

        <div class="contact-item reveal">
          <span>Blog</span>
          <a href="https://blog.vicenteperpina.com" target="_blank" rel="noopener">blog.vicenteperpina.com</a>
        </div>
      </div>

      <div class="contact-socials reveal">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Redes</p>
            <h2>También puedes encontrarme aquí</h2>
          </div>
          <p>Comparto dibujos, proyectos, publicaciones y parte de mi recorrido profesional en estas redes.</p>
        </div>

        <div class="contact-social-links">
          <a class="contact-social-link" href="https://www.instagram.com/vicenteperpinya/" target="_blank" rel="noopener">
            <span class="contact-social-link__name">Instagram</span>
            <span class="contact-social-link__handle">@vicenteperpinya</span>
            <span class="contact-social-link__arrow" aria-hidden="true">↗</span>
          </a>

          <a class="contact-social-link" href="https://es.linkedin.com/in/vicenteperpinya" target="_blank" rel="noopener">
            <span class="contact-social-link__name">LinkedIn</span>
            <span class="contact-social-link__handle">Vicente Perpiñá Giner</span>
            <span class="contact-social-link__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="contact-cta reveal">
        <p class="eyebrow">Dibujo · ilustración · educación</p>
        <h2>Un perfil artístico que también entra en el aula</h2>
        <p>
          Si quieres conocer mejor mi recorrido, puedes explorar la selección de obra y proyectos o mi experiencia docente.
        </p>
        <div class="hero-actions contact-actions">
          <a class="btn primary" href="/obra/">Ver obra</a>
          <a class="btn secondary" href="/docencia/">Ver docencia</a>
        </div>
      </div>

      <p class="quote reveal contact-quote">Dibujar · aprender · compartir</p>
    </div>
  </section>
  </main>
</BaseLayout>
