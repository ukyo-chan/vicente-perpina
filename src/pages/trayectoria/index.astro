---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTimelineGroups, loadProjects, PROJECT_SECTIONS, projectTimelineHref } from '../../lib/projects';

const projects = await loadProjects();
const timelineGroups = getTimelineGroups(
  projects.filter(project => project.timelineBlock === 'cronologia')
).map(group => ({
  ...group,
  areas: PROJECT_SECTIONS
    .map(section => ({
      id: section.id,
      title: section.title,
      projects: group.projects.filter(project => project.section === section.id)
    }))
    .filter(area => area.projects.length > 0)
}));
const publicActivityProjects = getTimelineGroups(
  projects.filter(project => project.timelineBlock === 'actividad-publica')
).flatMap(group => group.projects);
const vicentTimelineGroupId = timelineGroups.find(group =>
  group.order === 2021 || group.projects.some(project => project.year === 2021)
)?.id;
---
<BaseLayout
  title="Trayectoria · Vicente Perpiñá Giner"
  description="Comparto mi trayectoria artística, editorial y audiovisual, junto con proyectos, publicaciones, exposiciones y actividad pública."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Una mirada completa</p>
        <h1>Trayectoria</h1>
        <p>
          Desde 2004 conecto dibujo, ilustración, cómic, edición, animación, proyectos expositivos y docencia.
          Mi trayectoria artística se complementa con formación pedagógica y experiencia educativa.
        </p>
      </div>
    </section>

    <div class="section-nav-wrap">
      <nav class="container section-nav" aria-label="Secciones de trayectoria">
        <a href="#hitos">Cronología</a>
        <a href="#encuentros">Actividad pública</a>
      </nav>
    </div>

    <section class="section" id="hitos">
      <div class="container">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Cronología</p>
            <h2>Mi recorrido</h2>
          </div>
          <p>
            Aquí reúno una lectura rápida de mi recorrido creativo, editorial y profesional.
          </p>
        </div>

        <div class="career-timeline">
          {timelineGroups.map(group => (
            <>
              <article class="career-year reveal" id={group.id}>
                <div class="career-number">
                  {group.label}
                </div>
                <div class="career-events">
                  {group.areas.map(area => (
                    <section class="career-area" aria-labelledby={`${group.id}-${area.id}`}>
                      <h3 class="career-area-title" id={`${group.id}-${area.id}`}>{area.title}</h3>
                      <div class="career-area-events">
                        {area.projects.map(project => {
                          const href = projectTimelineHref(project);
                          const external = href?.startsWith('http');

                          return (
                            <div class="career-event">
                              {href ? (
                                <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                                  <strong>{project.timelineTitle ?? project.title}</strong>
                                  {(project.timelineDetail ?? project.summary) && <span>{project.timelineDetail ?? project.summary}</span>}
                                </a>
                              ) : (
                                <span class="career-event-static">
                                  <strong>{project.timelineTitle ?? project.title}</strong>
                                  {(project.timelineDetail ?? project.summary) && <span>{project.timelineDetail ?? project.summary}</span>}
                                </span>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    </section>
                  ))}
                </div>
              </article>

              {group.id === vicentTimelineGroupId && (
                <a
                  class="career-life-interlude reveal"
                  href="/trayectoria/una-vida-dibujando/#vicent-2021"
                  aria-label="Vicent, 2021. La vida cambió de ritmo. El dibujo siguió ahí. Leer Una vida dibujando"
                >
                  <span class="career-life-interlude__line" aria-hidden="true"></span>
                  <span class="career-life-interlude__content">
                    <strong>VICENT <span>· 2021</span></strong>
                    <small>La vida cambió de ritmo. El dibujo siguió ahí.</small>
                  </span>
                </a>
              )}
            </>
          ))}
        </div>

      </div>
    </section>

    <section class="section soft encounters-section" id="encuentros" aria-labelledby="encuentros-heading">
      <div class="container">
        <div class="encounters-block reveal">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Encuentros y divulgación</p>
              <h2 id="encuentros-heading">Actividad pública</h2>
            </div>
            <p>
              A lo largo de estos años también he participado en encuentros, presentaciones y congresos vinculados al cómic, la ilustración y la cultura visual, en ocasiones como moderador.
            </p>
          </div>

          <div class="encounters-list">
            {publicActivityProjects.map(project => {
              const href = projectTimelineHref(project);
              const external = href?.startsWith('http');

              return (
                <article class="encounter-item">
                  <span class="encounter-context">
                    {project.year ?? project.dateText}
                    {project.entity && <> · {project.entity}</>}
                  </span>
                  <div class="encounter-content">
                    {href ? (
                      <a class="encounter-title" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                        <strong>{project.timelineTitle ?? project.title}</strong>
                      </a>
                    ) : (
                      <strong class="encounter-title">{project.timelineTitle ?? project.title}</strong>
                    )}
                    {(project.timelineDetail ?? project.summary) && (
                      <span class="encounter-detail">{project.timelineDetail ?? project.summary}</span>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
