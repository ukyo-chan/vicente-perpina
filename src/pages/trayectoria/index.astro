---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTimelineGroups, loadProjects, projectTimelineHref } from '../../lib/projects';

const projects = await loadProjects();
const timelineGroups = getTimelineGroups(projects);
---
<BaseLayout
  title="Trayectoria · Vicente Perpiñá Giner"
  description="Comparto mi trayectoria artística, editorial, audiovisual y docente, junto con mi formación académica e idiomas."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Una mirada completa</p>
        <h1>Trayectoria</h1>
        <p>
          Llevo más de quince años conectando dibujo, ilustración, cómic, edición, animación, proyectos expositivos y docencia.
          Mi trayectoria artística se complementa con formación pedagógica y experiencia educativa.
        </p>
      </div>
    </section>

    <div class="section-nav-wrap">
      <nav class="container section-nav" aria-label="Secciones de trayectoria">
        <a href="#hitos">Cronología</a>
        <a href="#formacion">Formación</a>
      </nav>
    </div>

    <section class="section" id="hitos">
      <div class="container">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Cronología</p>
            <h2>Hitos seleccionados</h2>
          </div>
          <p>Aquí reúno una lectura rápida de mi recorrido creativo, editorial y profesional.</p>
        </div>

        <div class="career-timeline">
          {timelineGroups.map(group => (
            <article class="career-year reveal" id={group.id}>
              <div class="career-number">{group.label}</div>
              <div class="career-events">
                {group.projects.map(project => {
                  const href = projectTimelineHref(project);
                  const external = href?.startsWith('http');

                  return (
                    <div>
                      {href ? (
                        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                          <strong>{project.timelineTitle ?? project.title}</strong>
                          {(project.timelineDetail ?? project.summary) && <span>{project.timelineDetail ?? project.summary}</span>}
                        </a>
                      ) : (
                        <span class="career-event-static">
                          <strong>{project.timelineTitle ?? project.title}</strong>
                          {(project.timelineDetail ?? project.summary) && <span>{project.timelineDetail ?? project.summary}</span>}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section soft" id="formacion">
      <div class="container two-col">
        <section>
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">Formación</p>
              <h2>Base académica</h2>
            </div>
          </div>

          <div class="timeline">
            <article class="timeline-item reveal">
              <div class="timeline-date">2014</div>
              <div class="timeline-content">
                <h3>Máster Universitario en Profesor/a de Educación Secundaria</h3>
                <p>Universitat de València.</p>
              </div>
            </article>

            <article class="timeline-item reveal">
              <div class="timeline-date">2009 – 2011</div>
              <div class="timeline-content">
                <h3>Máster Universitario en Producción Artística: Arte y Tecnología</h3>
                <p>Universitat Politècnica de València.</p>
              </div>
            </article>

            <article class="timeline-item reveal">
              <div class="timeline-date">2008 – 2009</div>
              <div class="timeline-content">
                <h3>Título propio de Especialista Profesional en Animación: Arte e Industria</h3>
                <p>Universitat Politècnica de València.</p>
              </div>
            </article>

            <article class="timeline-item reveal">
              <div class="timeline-date">2004 – 2009</div>
              <div class="timeline-content">
                <h3>Licenciatura en Bellas Artes · Dibujo y Animación (optatividad)</h3>
                <p>Universitat Politècnica de València.</p>
              </div>
            </article>
          </div>
        </section>

        <aside>
          <section class="panel reveal">
            <p class="eyebrow">Formación complementaria</p>
            <ul class="compact-list">
              <li>
                <strong>2025 · Inclusión e intervención psicoeducativa · 500 h</strong>
                Universidad Nebrija.
              </li>
              <li>
                <strong>2024 · Herramientas para el aula · 220 h</strong>
                Universidad de Murcia.
              </li>
            </ul>
          </section>

          <section class="panel reveal panel-gap">
            <p class="eyebrow">Idiomas</p>
            <ul class="compact-list">
              <li><strong>Valenciano</strong>C2 JQCV · Capacitació · Diploma de Mestre de Valencià.</li>
              <li><strong>Inglés</strong>B2 EOI València · Acreditación en lenguas extranjeras.</li>
            </ul>
          </section>

          <section class="panel reveal panel-gap">
            <p class="eyebrow">Perfil</p>
            <h2>Dibujo e ilustración como eje</h2>
            <p>
              Mi formación en animación, vídeo, fotografía, narrativa audiovisual y arte y tecnología amplía una base centrada en dibujo,
              pintura e ilustración, y la llevo tanto a mis proyectos artísticos como a mi práctica docente.
            </p>
          </section>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
