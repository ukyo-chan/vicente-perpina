---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Trayectoria · Vicente Perpiñá Giner"
  description="Trayectoria artística, editorial, audiovisual y docente de Vicente Perpiñá Giner, junto con su formación académica e idiomas."
>
  <main>
<section class="page-hero">
    <div class="container">
      <p class="eyebrow">Una mirada completa</p>
      <h1>Trayectoria</h1>
      <p>
        Más de quince años conectando dibujo, ilustración, cómic, edición, animación, proyectos expositivos y docencia.
        Una trayectoria artística sostenida que se complementa con formación pedagógica y experiencia educativa.
      </p>
    </div>
  </section>

  <section class="section" id="hitos">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Cronología</p>
          <h2>Hitos seleccionados</h2>
        </div>
        <p>Una lectura rápida del recorrido creativo, editorial y profesional.</p>
      </div>

      <div class="career-timeline">
        <article class="career-year reveal" id="2026">
          <div class="career-number">2026</div>
          <div class="career-events">
            <div><strong>Galería interactiva sobre los polos</strong><span>Oceanogràfic de València · ilustración</span></div>
            <div><strong>Invitado · Salón del Cómic de València</strong><span>Autor invitado</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2025</div>
          <div class="career-events">
            <div><strong>37 Il·lustres x 37 Il·lustrats</strong><span>Centre del Carme · reinterpretación de Manuela Ballester</span></div>
            <div><strong>Vinyetari 5</strong><span><em>Una data, totes les dates</em> · Marc Zanón y Vicente Perpiñá</span></div>
            <div><strong>La DANA: un any després</strong><span>Exposición colectiva e itinerante de ilustración</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2023</div>
          <div class="career-events">
            <div><strong>Les victòries cal saber veure-les</strong><span>Centre del Carme · proyecto expositivo</span></div>
            <div><strong>Migajas</strong><span>Proyecto editorial · Edicions Anònimes</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2021–22</div>
          <div class="career-events">
            <div><strong>Històries de Superació II</strong><span>Publicación y exposición · Fundació Horta Sud / Centre del Carme</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2020</div>
          <div class="career-events">
            <div><strong>EL·LE(s)</strong><span>Proyecto coral de cómic · Edicions Anònimes</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2019 →</div>
          <div class="career-events">
            <div><strong>Edicions Anònimes · Plaça del Mercat</strong><span>Edición, autoedición y proyectos de cómic</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2015</div>
          <div class="career-events">
            <div><strong>Cuentos populares</strong><span>Exposición individual · Nuevo Centro Espai d'Art</span></div>
            <div><strong>Room Art · Migraciones visuales</strong><span>La Nau · Universitat de València</span></div>
            <div><strong>Dibujo Expandido</strong><span>Museo ABC · Colección DKV</span></div>
            <div><strong>Ilustrafic 2</strong><span>Congreso Internacional de Ilustración · UPV</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2012</div>
          <div class="career-events">
            <div><strong>Beca DKV Grand Tour</strong><span>Ganador · estancia en Nueva York</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2009–11</div>
          <div class="career-events">
            <div><strong>Animación y audiovisual</strong><span>La Taronja · Broquebac II · Al Vent · MEGA BLOKS / Halo · Gianni Markel</span></div>
          </div>
        </article>

        <article class="career-year reveal">
          <div class="career-number">2008</div>
          <div class="career-events">
            <div><strong>La Corbella</strong><span>Libro personal de ilustraciones · BBAA-UPV</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section soft" id="formacion">
    <div class="container two-col">
      <section>
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Formación</p>
            <h2>Base académica</h2>
          </div>
        </div>

        <div class="timeline">
          <article class="timeline-item reveal">
            <div class="timeline-date">2014</div>
            <div class="timeline-content">
              <h3>Máster Universitario en Profesor/a de Educación Secundaria</h3>
              <p>Universitat de València.</p>
            </div>
          </article>

          <article class="timeline-item reveal">
            <div class="timeline-date">2009 – 2011</div>
            <div class="timeline-content">
              <h3>Máster Universitario en Producción Artística: Arte y Tecnología</h3>
              <p>Universitat Politècnica de València.</p>
            </div>
          </article>

          <article class="timeline-item reveal">
            <div class="timeline-date">2008 – 2009</div>
            <div class="timeline-content">
              <h3>Título propio de Especialista Profesional en Animación: Arte e Industria</h3>
              <p>Universitat Politècnica de València.</p>
            </div>
          </article>

          <article class="timeline-item reveal">
            <div class="timeline-date">2004 – 2009</div>
            <div class="timeline-content">
              <h3>Licenciatura en Bellas Artes · Dibujo y Animación (optatividad)</h3>
              <p>Universitat Politècnica de València.</p>
            </div>
          </article>
        </div>
      </section>

      <aside>
        <section class="panel reveal">
          <p class="eyebrow">Formación complementaria</p>
          <ul class="compact-list">
            <li>
              <strong>2025 · Inclusión e intervención psicoeducativa · 500 h</strong>
              Universidad Nebrija.
            </li>
            <li>
              <strong>2024 · Herramientas para el aula · 220 h</strong>
              Universidad de Murcia.
            </li>
          </ul>
        </section>

        <section class="panel reveal panel-gap">
          <p class="eyebrow">Idiomas</p>
          <ul class="compact-list">
            <li><strong>Valenciano</strong>C2 JQCV · Capacitació · Diploma de Mestre de Valencià.</li>
            <li><strong>Inglés</strong>B2 EOI València · Acreditación en lenguas extranjeras.</li>
          </ul>
        </section>

        <section class="panel reveal panel-gap">
          <p class="eyebrow">Perfil</p>
          <h2>Dibujo e ilustración como eje</h2>
          <p>
            La formación en animación, vídeo, fotografía, narrativa audiovisual y arte y tecnología amplía una base centrada en dibujo,
            pintura e ilustración, y se traslada tanto a proyectos artísticos como a la práctica docente.
          </p>
        </section>
      </aside>
    </div>
  </section>
  </main>
</BaseLayout>
