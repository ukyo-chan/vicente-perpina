---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeProjectCard from '../components/projects/HomeProjectCard.astro';
import { getHomeFeaturedProjects, getHomeHighlights, loadProjects, projectDateLabel, projectPrimaryHref } from '../lib/projects';

const projects = await loadProjects();
const featuredProjects = getHomeFeaturedProjects(projects);
const homeHighlights = getHomeHighlights(projects);
---
<BaseLayout
  title="Vicente Perpiñá Giner · Ilustración, cómic y docencia"
  description="Mi web profesional: ilustración, dibujo, cómic, edición, animación, audiovisual y docencia artística."
>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="portrait-wrap reveal">
          <div class="portrait-bg"></div>
          <img class="portrait" src="/assets/img/vicente.png" alt="Retrato de Vicente Perpiñá Giner" />
          <span class="doodle one">✦ dibujar</span>
          <span class="doodle two">aprender · compartir</span>
        </div>

        <div class="reveal">
          <p class="eyebrow">Ilustración · cómic · docencia</p>
          <h1>Vicente<br />Perpiñá Giner</h1>
          <p class="hero-role">Ilustrador · Profesor de dibujo · Autor y editor de cómic</p>
          <p class="hero-copy">
            Dibujo e ilustración son el eje de mi trayectoria. A partir de ahí he ido conectando creación, cómic, edición,
            animación, audiovisual y docencia. Mi trabajo se ha desarrollado entre proyectos propios,
            exposiciones, publicaciones y una actividad educativa continuada con alumnado de diferentes edades.
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="/obra/">Ver obra y proyectos</a>
            <a class="btn secondary" href="/docencia/">Conocer mi experiencia docente</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section soft">
      <div class="container">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Selección</p>
            <h2>Proyectos destacados</h2>
          </div>
          <p>Aquí reúno una trayectoria pública que cruza ilustración, exposición, cómic y proyectos culturales.</p>
        </div>

        <div class="featured-grid">
          {featuredProjects.map(project => <HomeProjectCard project={project} />)}
        </div>

        {homeHighlights.length > 0 && (
          <div class="highlight-strip reveal" aria-label="Otros hitos recientes">
            {homeHighlights.map(project => (
              <a href={projectPrimaryHref(project)}>
                <strong>{projectDateLabel(project)}</strong>
                {project.homeHighlightText ?? project.title}
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Perfil</p>
            <h2>Crear, editar, enseñar</h2>
          </div>
          <p>Mi práctica artística y mi experiencia docente forman parte de un mismo recorrido profesional.</p>
        </div>

        <div class="cards">
          <a class="card reveal" href="/obra/">
            <span class="card-kicker">01 · Obra, cómic y edición</span>
            <h3>Ilustración, cómic y proyectos editoriales</h3>
            <p>Reúno proyectos de dibujo e ilustración, exposiciones, autoedición, antologías, Edicions Anònimes, Plaça del Mercat y cómic de carácter social.</p>
          </a>

          <a class="card reveal" href="/docencia/">
            <span class="card-kicker">02 · Docencia</span>
            <h3>El arte también educa</h3>
            <p>Enseño dibujo, pintura, ilustración, cómic y dibujo técnico a niños, jóvenes y adultos.</p>
          </a>

          <a class="card reveal" href="/trayectoria/">
            <span class="card-kicker">03 · Trayectoria</span>
            <h3>Más de quince años de recorrido</h3>
            <p>En mi trayectoria reúno formación artística, animación, audiovisual, proyectos públicos y experiencia educativa.</p>
          </a>

          <a class="card reveal" href="/prensa/">
            <span class="card-kicker">04 · Prensa</span>
            <h3>Prensa y medios</h3>
            <p>Mi archivo de prensa reúne entrevistas, reportajes, crónicas y apariciones vinculadas a mi trabajo.</p>
          </a>
        </div>

        <p class="quote reveal">«El arte también educa»</p>
      </div>
    </section>
  </main>
</BaseLayout>
