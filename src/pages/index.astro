---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeComicArea from '../components/home/HomeComicArea.astro';
import HomeComicTextPanel from '../components/home/HomeComicTextPanel.astro';
import { getHomeActiveAreas, getHomeRecentWindow } from '../lib/home';
import { loadProjects } from '../lib/projects';
import { loadTeaching } from '../lib/teaching';

const projects = await loadProjects();
const teaching = await loadTeaching();
const currentYear = new Date().getFullYear();
const recentWindow = getHomeRecentWindow(currentYear);
const homeAreas = getHomeActiveAreas(projects, teaching, currentYear);
---
<BaseLayout
  title="Vicente Perpiñá Giner · Ilustración, cómic y docencia"
  description="Mi web profesional: ilustración, dibujo, cómic, edición, animación, audiovisual y docencia artística."
>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="portrait-wrap reveal">
          <div class="portrait-bg"></div>
          <img class="portrait" src="/assets/img/vicente.jpeg" alt="Retrato de Vicente Perpiñá Giner" />
          <span class="doodle one">✦ dibujar</span>
          <span class="doodle two">aprender · compartir</span>
        </div>

        <div class="reveal">
          <p class="eyebrow">Ilustración · cómic · docencia</p>
          <h1>Vicente<br />Perpiñá Giner</h1>
          <p class="hero-role">Ilustrador · Profesor de dibujo · Autor y editor de cómic</p>
          <p class="hero-copy">
            Dibujo e ilustración son el eje de mi trayectoria. A partir de ahí he ido conectando creación, cómic, edición,
            animación, audiovisual y docencia. Mi trabajo se ha desarrollado entre proyectos propios,
            exposiciones, publicaciones y una actividad educativa continuada con alumnado de diferentes edades.
          </p>
          <div class="hero-actions">
            <a class="btn primary" href="/obra/">Ver obra y proyectos</a>
            <a class="btn secondary" href="/docencia/">Conocer mi experiencia docente</a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-recent-work" aria-labelledby="home-recent-title">
      <div class="container">
        <div class="home-recent-intro reveal">
          <div>
            <p class="eyebrow">{recentWindow.cutoffYear}–{recentWindow.currentYear}</p>
            <h2 id="home-recent-title">Trabajo reciente</h2>
          </div>
          <p>Aquí reúno las áreas en las que mi trabajo está más activo ahora.</p>
        </div>

        <div class="home-comic-areas">
          {homeAreas.map((area, index) => (
            <HomeComicArea area={area} number={String(index + 1).padStart(2, '0')} />
          ))}
        </div>
      </div>
    </section>

    <section class="home-closing-section" aria-labelledby="home-closing-title">
      <div class="container">
        <div class="home-closing-heading reveal">
          <div>
            <p class="eyebrow">El archivo continúa</p>
            <h2 id="home-closing-title">Seguir explorando</h2>
          </div>
          <p>Trayectoria, prensa y contacto completan el recorrido.</p>
        </div>

        <div class="home-closing-grid reveal">
          <HomeComicTextPanel
            variant="closing"
            kicker="Trayectoria"
            title="Mi recorrido"
            text="Cronología, encuentros y base académica."
            href="/trayectoria/"
            linkLabel="Recorrer mi trayectoria"
          />
          <HomeComicTextPanel
            variant="closing"
            kicker="En medios"
            title="Prensa y medios"
            text="Entrevistas, reportajes, crónicas y otras apariciones."
            href="/prensa/"
            linkLabel="Consultar prensa"
          />
          <HomeComicTextPanel
            variant="closing"
            kicker="Contacto"
            title="Hablemos"
            text="Si quieres contar conmigo para un proyecto, puedes escribirme."
            href="/contacto/"
            linkLabel="Contactar"
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
